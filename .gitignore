Archive.zip

# Bundled LSP resources — regenerated by scripts/lsp/fetch-macos-arm64.sh from
# the pinned, hash-verified artifacts in packaging/lsp/manifest.toml. Upstream
# binaries are never committed. The directory itself is tracked through a
# placeholder because tauri.conf.json declares it as a bundle resource and
# tauri-build refuses to compile when a declared resource path is missing.
# These rules must stay AFTER the generic `dist/` rule above: the last matching
# pattern wins, and git will not descend into a directory it considers ignored.
!packaging/lsp/dist/
packaging/lsp/dist/*
!packaging/lsp/dist/.gitkeep
packaging/lsp/.staging.*
packaging/lsp/.previous.*

# Frontend vendor build (esbuild-generated CodeMirror bundle)
crates/termlab_tauri/frontend/node_modules/
crates/termlab_tauri/frontend/vendor/codemirror/
